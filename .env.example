NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
MAX_HOP=2
SIMILARITY_THRESHOLD=0.65
# So Article toi da dua vao ngu canh cho LLM - do that: recall bao hoa o 10
MAX_CONTEXT_ARTICLES=10
INGEST_BATCH_SIZE=200
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=legal_articles
EMBEDDING_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=32
# Reranker (cross-encoder) - tat de tiet kiem RAM/CPU tren may yeu hon
# (laptop 16GB: cân nhắc RERANK_ENABLED=false khi chỉ code, không cần đo QA that)
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=1024
RERANK_FETCH_K=15
